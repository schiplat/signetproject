SIGNET_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/signet
# Optional alias used by tests (falls back to SIGNET_DATABASE_URL if unset)
TEST_DATABASE_URL=postgres://user:pass@127.0.0.1:5432/signet
SIGNET_HTTP_BIND=0.0.0.0:8443
SIGNET_ISSUER=http://localhost:8443
SIGNET_COOKIE_SECURE=false

# Required on first boot when no admin exists
SIGNET_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
SIGNET_BOOTSTRAP_ADMIN_PASSWORD=changeme-admin

# Seed / upsert the cella OIDC client
SIGNET_CELLA_CLIENT_SECRET=cella-dev-secret
SIGNET_CELLA_REDIRECT_URIS=http://localhost:3000/auth/callback

# Optional: PEM path for RSA private key (generated & persisted under data/ if unset)
# SIGNET_JWT_PRIVATE_KEY_PATH=./data/jwt_private.pem

# Optional: path for the AES-256-GCM key used to encrypt TOTP secrets at rest
# (generated & persisted under data/ if unset)
# SIGNET_ENCRYPTION_KEY_PATH=./data/encryption.key

# Login security & password policy (defaults shown)
# SIGNET_MAX_LOGIN_ATTEMPTS=5
# SIGNET_LOCKOUT_MINUTES=15
# SIGNET_PASSWORD_MIN_LENGTH=10
# SIGNET_PASSWORD_HISTORY_SIZE=3

# Audit retention (days; older rows are pruned on startup)
# SIGNET_AUDIT_RETENTION_DAYS=180

# Optional: one-time seed for the SCIM bearer token (only applied while no token
# exists in the DB). Afterwards, generate/rotate/revoke the token in
# Admin -> Integrations -> SCIM v2.
# SIGNET_SCIM_BEARER_TOKEN=change-me-scim-token

# WebAuthn relying-party identity (override for production).
# RP_ID must be a domain suffix of RP_ORIGIN, and production requires HTTPS.
# e.g. SIGNET_WEBAUTHN_RP_ID=sso.example.com
#      SIGNET_WEBAUTHN_RP_ORIGIN=https://sso.example.com
# SIGNET_WEBAUTHN_RP_ID=localhost
# SIGNET_WEBAUTHN_RP_ORIGIN=http://localhost:8443
